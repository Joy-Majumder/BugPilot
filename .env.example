# BugPilot Configuration
# Copy to .env and modify as needed

# OOB Server Domain (must be a domain you control for real OOB callbacks)
OOB_DOMAIN=oob.local

# OOB Server Ports
OOB_HTTP_PORT=8081
OOB_DNS_PORT=5353

# Web UI Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Default Scan Settings
DEFAULT_RATE_LIMIT=10
DEFAULT_CONCURRENCY=5
REQUEST_TIMEOUT=30